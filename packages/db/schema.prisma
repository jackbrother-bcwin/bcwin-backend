    position       FiveDPosition? // A, B, C, D, E for position bets

    status BetStatus @default(PENDING)

    fiveDBetResult FiveDBetResult?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([periodId])
    @@index([status])
    @@index([betType])
    @@index([betCategory])
    @@index([position])
    @@index([createdAt])
    @@index([userId, periodId])
}

