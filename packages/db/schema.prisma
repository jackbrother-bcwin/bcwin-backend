enum PeriodStatus {
    ACTIVE // Period running, accepting bets
    ENDED // Period ended, calculating results
    RESOLVED // Results calculated and payouts processed
}

enum BetStatus {
    PENDING // Bet placed, period not resolved
    WON // Bet won, payout processed
    LOST // Bet lost
}

enum MotoBetType {
    POSITION // Exact bike number in position
    ODD_EVEN // Odd/Even number in position
    BIG_SMALL // Big (6-10) / Small (1-5) in position
}

enum MotoPosition {
    FIRST // 1st place
    SECOND // 2nd place
    THIRD // 3rd place
}

enum K3BetType {
    SUM // Specific sum (3-18)
    TRIPLE_ANY // Any triple (111, 222, ..., 666)
    TRIPLE_SPECIFIC // Specific triple (e.g., 333)
    DOUBLE_ANY // Any double (but not triple)
    DOUBLE_SPECIFIC // Specific double combo (e.g., 4,4,6)
    ALL_DIFFERENT // All dice unique
    TWO_NUMBERS // Both chosen numbers appear
    CONSECUTIVE // Consecutive sequence
    BIG // Sum 11-18
    SMALL // Sum 3-10
    ODD // Sum is odd
    EVEN // Sum is even
}

enum FiveDBetType {
    EXACT_NUMBER // Position exact number (0-9)
    LOW // Position low (0-4) or Sum low (0-22)
    HIGH // Position high (5-9) or Sum high (23-45)
    ODD // Position odd or Sum odd
    EVEN // Position even or Sum even
    SUM_EXACT // Sum exact number (0-45)
}

enum FiveDBetCategory {
    POSITION // Position-based bets (A-E)
    SUM // Sum-based bets
}

enum FiveDPosition {
    A // First digit
    B // Second digit  
    C // Third digit
    D // Fourth digit
    E // Fifth digit
}

enum WingoResultColor {
    RED
    GREEN
    VIOLET
}

enum WingoResultSize {
    BIG
    SMALL
}

enum WingoBetType {
    COLOR // RED, GREEN, VIOLET
    NUMBER // 0-9
    SIZE // BIG, SMALL
}

enum Role {
    USER
    ADMIN
    SUB_ADMIN
    AGENT
}

/// Game category for multi-level team rebate rates (independent of commission)
/// Display order (Commission Details): Lottery → Slots → Casino → Sports → Chess/card
enum RebateGameCategory {
    LOTTERY
    SLOTS
    CASINO
    SPORTS
    RUMMY
}

enum PaymentOrderStatus {
    PROCESSING
    SUCCESS
    FAILED
}

enum WithdrawOrderStatus {
    GENERATED
    PROCESSING
    SUCCESS
    FAILED
    USER_CANCELED
}

enum GiftType {
    FIXED
    UPTO
}

enum QueryType {
    DEPOSIT
    WITHDRAWAL
    BANK_CHANGE
    BONUS
}

enum QueryStatus {
    CREATED
    VERIFIED
    PROCESSING
    COMPLETED
    REJECTED
}

/// Which spin product a rule/reward belongs to
enum SpinWheelKind {
    INVITE // Invite Wheel (bottom-nav / activity invite)
    LUCKY // Lucky Spin (activity lucky spin — rupee prizes only)
}

model LuckySpinRule {
    id          String        @id @default(uuid())
    kind        SpinWheelKind @default(INVITE)
    minDeposit  Float
    spinChances Int
    isActive    Boolean       @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive])
    @@index([kind, isActive])
}

model LuckySpinReward {
    id          String        @id @default(uuid())
    kind        SpinWheelKind @default(INVITE)
    amount      Float
    probability Float // weight
    isActive    Boolean       @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive])
    @@index([kind, isActive])
}

enum WagerRequirementType {
    RECHARGE
    REWARD
}

model WagerRequirement {
    id            String               @id @default(uuid())
    userId        String
    user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    sourceType    WagerRequirementType
    sourceId      String?
    amount        Float
    multiplier    Float                @default(1.0)
    requiredWager Float
    wagerCleared  Float                @default(0)
    isCleared     Boolean              @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([userId, isCleared])
    @@index([createdAt])
}
