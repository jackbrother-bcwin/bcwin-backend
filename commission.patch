+                dice3: 6,
+                sum: 18,
+                isTriple: true,
+                isDouble: false,
+                isAllDifferent: false,
+                isConsecutive: false,
+                isBig: true,
+                isSmall: false,
+                isOdd: false,
+                isEven: true,
+            };
+            const bet = {
+                betType: "BIG",
+                betChoice: "BIG",
+                betAmount: 10,
+                contractAmount: 9.8,
+            } as any;
+
+            if (typeof (K3GameLogic as any).checkBetWin === "function") {
