+import { describe, test, expect, beforeAll, afterAll } from "bun:test";
+import { prisma } from "@bcwin/db";
+import {
+    FixtureTracker,
+    createTestUser,
+    cleanupByUserIds,
+    ensureSystemConfig,
+    createActiveWingoPeriod,
+} from "../helpers";
+import { mapPool, settleConcurrency } from "../../apps/engine/src/services/utils/mapPool";
+import { GameLogic } from "../../apps/engine/src/services/wingo/gameLogic";
+import { BetSettlement } from "../../apps/engine/src/services/wingo/betSettlement";
+import { PeriodManager } from "../../apps/engine/src/services/wingo/periodManager";
+import { CommissionCalculator } from "../../apps/engine/src/services/commission/commissionCalculator";
+import {
+    enqueuePostSettleJob,
+    postSettleQueueDepth,
+    POST_SETTLE_QUEUE_KEY,
+} from "../../packages/jobs/index";
+import { Cache } from "@bcwin/cache";
+import { recordSchedulerSkip, getSchedulerSkipCounts } from "../../apps/engine/src/services/utils/schedulerMetrics";
+
+describe("Engine: mapPool / gameLogic / settle / jobs / metrics", () => {
+    const tracker = new FixtureTracker("eng");
+    let bettor: Awaited<ReturnType<typeof createTestUser>>;
+    let upline: Awaited<ReturnType<typeof createTestUser>>;
+
+    beforeAll(async () => {
+        process.env.PROCESS_ROLE = "engine";
+        await ensureSystemConfig();
+        upline = await createTestUser(tracker, { balance: 0 });
+        bettor = await createTestUser(tracker, {
+            balance: 5_000,
+            referredBy: upline.referralCode,
+        });
+    });
+
+    afterAll(async () => {
+        // Drain any leftover test jobs from redis list
+        try {
+            await Cache.client.del(POST_SETTLE_QUEUE_KEY);
+        } catch {
+            /* ignore */
+        }
+        await cleanupByUserIds(tracker.userIds, {
+            periodPrefix: tracker.periodPrefix,
+        });
+    });
+
+    describe("mapPool", () => {
+        test("runs with concurrency limit and preserves order", async () => {
+            const items = [1, 2, 3, 4, 5, 6, 7, 8];
+            let maxConcurrent = 0;
+            let current = 0;
+
+            const results = await mapPool(items, 3, async (n) => {
+                current++;
+                maxConcurrent = Math.max(maxConcurrent, current);
+                await Bun.sleep(20);
+                current--;
+                return n * 10;
+            });
+
+            expect(results).toEqual([10, 20, 30, 40, 50, 60, 70, 80]);
+            expect(maxConcurrent).toBeLessThanOrEqual(3);
+            expect(settleConcurrency()).toBeGreaterThanOrEqual(1);
+        });
+
+        test("empty input returns []", async () => {
+            expect(await mapPool([], 5, async (x) => x)).toEqual([]);
+        });
+    });
+
+    describe("Wingo GameLogic", () => {
+        const mockBet = (betType: string, betChoice: string) =>
+            ({
+                id: "x",
+                userId: "u",
+                periodId: "p",
+                betAmount: 10,
+                contractAmount: 9.8,
+                betType,
+                betChoice,
+                status: "PENDING",
+                createdAt: new Date(),
+                updatedAt: new Date(),
+            }) as any;
+
+        test("NUMBER win/loss", () => {
+            const bet = mockBet("NUMBER", "7");
+            expect(GameLogic.checkBetWin(bet, { number: 7, color: "GREEN", size: "BIG" })).toBe(
+                true
+            );
+            expect(GameLogic.checkBetWin(bet, { number: 3, color: "GREEN", size: "SMALL" })).toBe(
+                false
+            );
+            expect(
+                GameLogic.getWinMultiplier(bet, { number: 7, color: "GREEN", size: "BIG" })
+            ).toBe(9);
+        });
+
+        test("COLOR RED/GREEN/VIOLET", () => {
+            expect(
+                GameLogic.checkBetWin(mockBet("COLOR", "RED"), {
+                    number: 2,
+                    color: "RED",
+                    size: "SMALL",
+                })
+            ).toBe(true);
+            expect(
+                GameLogic.checkBetWin(mockBet("COLOR", "VIOLET"), {
+                    number: 0,
+                    color: "RED",
+                    size: "SMALL",
+                })
+            ).toBe(true);
+            expect(
+                GameLogic.checkBetWin(mockBet("COLOR", "VIOLET"), {
+                    number: 1,
+                    color: "GREEN",
+                    size: "SMALL",
+                })
+            ).toBe(false);
+        });
+
+        test("SIZE BIG/SMALL", () => {
+            expect(
+                GameLogic.checkBetWin(mockBet("SIZE", "BIG"), {
+                    number: 8,
+                    color: "RED",
+                    size: "BIG",
+                })
+            ).toBe(true);
+            expect(
+                GameLogic.checkBetWin(mockBet("SIZE", "SMALL"), {
+                    number: 2,
+                    color: "RED",
+                    size: "SMALL",
+                })
+            ).toBe(true);
+        });
+
+        test("validateBetChoice", () => {
+            expect(GameLogic.validateBetChoice("COLOR", "RED")).toBe(true);
+            expect(GameLogic.validateBetChoice("COLOR", "BLUE")).toBe(false);
+            expect(GameLogic.validateBetChoice("NUMBER", "9")).toBe(true);
+            expect(GameLogic.validateBetChoice("NUMBER", "10")).toBe(false);
+        });
+    });
+
+    describe("PeriodManager + BetSettlement (integration)", () => {
+        test("createPeriodsForAllDurations does not throw", async () => {
+            const pm = new PeriodManager();
+            await pm.createPeriodsForAllDurations();
+            await pm.endActivePeriods();
+        });
+
+        test("settle pending wingo bets → RESOLVED + balance credit on win", async () => {
+            const period = await createActiveWingoPeriod(tracker, 60);
+            // Force ENDED with known result (number 7 = GREEN BIG)
+            await prisma.wingoPeriod.update({
+                where: { id: period.id },
+                data: {
+                    status: "ENDED",
+                    endTime: new Date(Date.now() - 1000),
+                    resultNumber: 7,
+                    resultColor: "GREEN",
+                    resultSize: "BIG",
+                },
+            });
+
+            const betAmount = 100;
+            const contractAmount = 98;
+            const before = await prisma.user.findUniqueOrThrow({
+                where: { id: bettor.id },
+            });
+
+            await prisma.wingoBet.create({
+                data: {
+                    userId: bettor.id,
+                    periodId: period.id,
+                    betAmount,
+                    contractAmount,
+                    betType: "NUMBER",
+                    betChoice: "7",
+                    status: "PENDING",
+                },
+            });
+
+            // Also a losing bet path
+            await prisma.wingoBet.create({
+                data: {
+                    userId: bettor.id,
+                    periodId: period.id,
+                    betAmount: 10,
+                    contractAmount: 9.8,
+                    betType: "NUMBER",
+                    betChoice: "1",
+                    status: "PENDING",
+                },
+            });
+
+            const settlement = new BetSettlement();
+            await settlement.settleAllEndedPeriodsWithResults();
+
+            const updatedPeriod = await prisma.wingoPeriod.findUniqueOrThrow({
+                where: { id: period.id },
+            });
+            expect(updatedPeriod.status).toBe("RESOLVED");
+
+            const bets = await prisma.wingoBet.findMany({
+                where: { periodId: period.id },
+                include: { wingoBetResult: true },
+            });
+            expect(bets.every((b) => b.status !== "PENDING")).toBe(true);
+
+            const winBet = bets.find((b) => b.betChoice === "7");
+            expect(winBet?.status).toBe("WON");
+            expect(winBet?.wingoBetResult?.isWin).toBe(true);
+
+            const after = await prisma.user.findUniqueOrThrow({
+                where: { id: bettor.id },
+            });
+            // Win amount = contract * 9 for NUMBER
+            expect(after.balance).toBeGreaterThan(before.balance);
+        });
+    });
+
+    describe("Commission calculator", () => {
+        test("calculateCommissionForBet for upline does not throw", async () => {
+            const period = await createActiveWingoPeriod(tracker, 180);
+            const bet = await prisma.wingoBet.create({
+                data: {
+                    userId: bettor.id,
+                    periodId: period.id,
+                    betAmount: 50,
+                    contractAmount: 49,
+                    betType: "SIZE",
+                    betChoice: "BIG",
+                    status: "LOST",
+                },
+            });
+
+            await CommissionCalculator.calculateCommissionForBet(
+                bet.id,
+                "WINGO",
+                bettor.id,
+                50,
+                49
+            );
+
+            // May be 0 rates if configs empty — still should not throw
+            const commissions = await prisma.commission.findMany({
+                where: { fromUserId: bettor.id },
+            });
+            expect(Array.isArray(commissions)).toBe(true);
+        });
+    });
+
+    describe("Post-settle job queue", () => {
+        test("enqueue increases queue depth", async () => {
+            const before = await postSettleQueueDepth();
+            await enqueuePostSettleJob({
+                type: "rebate",
+                betId: "test-bet-id",
+                game: "WINGO",
+                userId: bettor.id,
+                betAmount: 10,
+            });
+            const after = await postSettleQueueDepth();
+            expect(after).toBeGreaterThanOrEqual(before === -1 ? 0 : before);
+            // cleanup job we pushed
+            await Cache.client.lpop(POST_SETTLE_QUEUE_KEY).catch(() => null);
+        });
+    });
+
+    describe("Scheduler metrics", () => {
+        test("recordSchedulerSkip increments counters", () => {
+            recordSchedulerSkip("deeptest-wingo");
+            recordSchedulerSkip("deeptest-wingo");
+            const counts = getSchedulerSkipCounts();
+            expect(counts["deeptest-wingo"]).toBeGreaterThanOrEqual(2);
+        });
+    });
+});
